---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
import Timer from '../components/Timer.astro';
import QuoteDisplay from '../components/QuoteDisplay.astro';
import SettingsModal from '../components/SettingsModal.astro';
---

<Layout>
  <div class="container hero-section">
    <!-- Top Challenge Banner -->
    <div class="challenge-strip">
      <div class="challenge-tag">
        <span class="pulse-leaf">🌱</span>
        <span>HACKTOBERFEST 2026 OPEN-SOURCE AI CHALLENGE — WEEK 1: TOUCH GRASS</span>
      </div>
      <div class="render-badge">
        <span class="render-dot"></span>
        <span>RENDER READY (STATIC DIST)</span>
      </div>
    </div>

    <!-- Main Dashboard Grid -->
    <div class="dashboard-grid">
      <!-- Left Column: Avatar & Stage -->
      <div class="col-stage">
        <div class="avatar-box glass-card">
          <Avatar />
        </div>

        <!-- Chad Rules of Discipline -->
        <div class="rules-card glass-card">
          <div class="rules-header">
            <span class="rules-icon">🛡️</span>
            <h3 class="rules-title">THE CHADODORO CODE</h3>
          </div>
          <ul class="rules-list">
            <li>
              <span class="rule-num">01</span>
              <div>
                <strong>Zero Distractions:</strong> Lock into deep work with tunnel vision.
              </div>
            </li>
            <li>
              <span class="rule-num">02</span>
              <div>
                <strong>Radical Screen Break:</strong> When time is up, step away from monitors.
              </div>
            </li>
            <li>
              <span class="rule-num">03</span>
              <div>
                <strong>Touch Physical Grass:</strong> Reconnect with sunlight, earth, and oxygen.
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Timer & Controls & Provenance -->
      <div class="col-timer">
        <!-- Main Timer Card -->
        <div class="timer-card glass-card">
          <Timer />
        </div>

        <!-- Latest Coach Quote Card -->
        <QuoteDisplay />

        <!-- Git Voice Vault Info Box -->
        <div class="vault-info-card glass-card">
          <div class="vault-header">
            <div class="vault-title-wrap">
              <span class="vault-icon">🎙️</span>
              <h3 class="vault-title">GIT VOICE VAULT REPOSITORY</h3>
            </div>
            <span class="badge-chad">16 CLIPS COMMITTED</span>
          </div>
          <p class="vault-desc">
            Clips pre-rendered via <code>google/gemma-4-26B-A4B-it</code> and synthesized across multiple GigaChad voices (Adam, Harry, Brian).
            Served entirely as static assets under <code>public/vault/</code> with 0ms runtime API latency.
          </p>
          <div class="vault-categories-grid">
            <div class="vault-cat-pill">
              <span class="cat-dot dot-focus"></span>
              <span>START_FOCUS (4)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-break"></span>
              <span>SHORT_BREAK (4)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-long"></span>
              <span>LONG_BREAK (4)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-motivation"></span>
              <span>CHAD_MOTIVATION (4)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Keyboard Shortcuts Bar -->
    <div class="shortcuts-bar">
      <span class="shortcut-item"><kbd>Space</kbd> Start / Pause</span>
      <span class="shortcut-item"><kbd>R</kbd> Reset</span>
      <span class="shortcut-item"><kbd>S</kbd> Skip Phase</span>
      <span class="shortcut-item"><kbd>M</kbd> Instant Motivation</span>
      <span class="shortcut-item"><kbd>G</kbd> Touch Grass</span>
      <span class="shortcut-item"><kbd>V</kbd> Coach Voice</span>
      <span class="shortcut-item"><kbd>B</kbd> Anthem BGM</span>
      <span class="shortcut-item"><kbd>Esc</kbd> Close Settings</span>
    </div>
  </div>

  <!-- Settings Modal Component -->
  <SettingsModal />
</Layout>

<style>
  .hero-section {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Challenge Strip */
  .challenge-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(18, 24, 36, 0.6);
    border: 1px solid var(--border-subtle);
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .challenge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--emerald-bright);
  }

  .pulse-leaf {
    animation: gentleBounce 2s ease-in-out infinite;
  }

  @keyframes gentleBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .render-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .render-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  /* Main Dashboard Grid */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .dashboard-grid {
      grid-template-columns: 340px 1fr;
    }
  }

  /* Stage Column */
  .col-stage {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .avatar-box {
    padding: 1.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rules-card {
    padding: 1.25rem;
  }

  .rules-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .rules-icon {
    font-size: 1.1rem;
  }

  .rules-title {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
  }

  .rules-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .rules-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.78rem;
    color: var(--text-sub);
    line-height: 1.35;
  }

  .rule-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--emerald-bright);
    background: var(--bg-surface);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .rules-list strong {
    color: var(--text-main);
  }

  /* Timer Column */
  .col-timer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timer-card {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Vault Info Card */
  .vault-info-card {
    padding: 1.25rem 1.5rem;
  }

  .vault-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vault-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .vault-icon {
    font-size: 1rem;
  }

  .vault-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
  }

  .vault-desc {
    font-size: 0.8rem;
    color: var(--text-sub);
    line-height: 1.45;
    margin-bottom: 0.85rem;
  }

  .vault-desc code {
    font-family: var(--font-mono);
    background: var(--bg-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--emerald-bright);
    font-size: 0.75rem;
  }

  .vault-categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.5rem;
  }

  .vault-cat-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-sub);
    font-family: var(--font-mono);
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-focus { background: var(--emerald-bright); }
  .dot-break { background: #fde047; }
  .dot-long { background: #38bdf8; }
  .dot-motivation { background: var(--gold-main); }

  /* Shortcuts Bar */
  .shortcuts-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: rgba(18, 24, 36, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .shortcut-item {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  kbd {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  @media (max-width: 680px) {
    .hero-section {
      padding-top: 1rem;
      padding-bottom: 2rem;
      gap: 1.15rem;
    }

    .challenge-strip {
      padding: 0.5rem 0.75rem;
      gap: 0.5rem;
    }

    .challenge-tag {
      font-size: 0.68rem;
    }

    .timer-card {
      padding: 1.5rem 0.85rem;
    }

    .rules-card, .vault-info-card {
      padding: 1.15rem 1rem;
    }

    .shortcuts-bar {
      display: none;
    }
  }
</style>
