---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
import Timer from '../components/Timer.astro';
import QuoteDisplay from '../components/QuoteDisplay.astro';
import SettingsModal from '../components/SettingsModal.astro';
---

<Layout>
  <div class="container hero-section">
    <!-- Top Challenge Banner -->
    <div class="challenge-strip">
      <div class="challenge-tag">
        <span class="pulse-leaf">🌱</span>
        <span>HACKTOBERFEST 2026 OPEN-SOURCE AI CHALLENGE — WEEK 1: TOUCH GRASS</span>
      </div>
      <div class="render-badge">
        <span class="render-dot"></span>
        <span>RENDER READY (STATIC DIST)</span>
      </div>
    </div>

    <!-- Main Dashboard Grid -->
    <div class="dashboard-grid">
      <!-- Left Column: Unified Chad Coach & Avatar Stage -->
      <div class="col-stage">
        <div class="coach-unified-card glass-card">
          <!-- Card Header -->
          <div class="coach-header">
            <div class="coach-header-top">
              <div class="coach-title-wrap">
                <span class="coach-icon">👑</span>
                <h3 class="coach-title">CHADODORO COACH</h3>
              </div>
              <button class="btn-audio-replay" id="btn-quote-replay" title="Replay voice audio">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                  <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 13c0-4.42-3.58-8-8-8zm-6 8c0-1.01.25-1.97.7-2.8L5.24 8.74A7.93 7.93 0 0 0 4 13c0 4.42 3.58 8 8 8v4l5-5-5-5v4c-3.31 0-6-2.69-6-6z" />
                </svg>
                <span>REPLAY</span>
              </button>
            </div>
            <div class="coach-header-sub">
              <span class="badge-chad" id="quote-category-badge">START_FOCUS</span>
              <span class="coach-status-pill">
                <span class="pulse-emerald"></span>
                <span>LIVE DISCIPLINE</span>
              </span>
            </div>
          </div>

          <!-- GigaChad Avatar Stage Area -->
          <div class="coach-avatar-area">
            <Avatar />
          </div>

          <!-- Coach Speech Quote Section -->
          <QuoteDisplay />
        </div>
      </div>

      <!-- Right Column: Timer & Controls & Provenance -->
      <div class="col-timer">
        <!-- Main Timer Card -->
        <div class="timer-card glass-card">
          <Timer />
        </div>

        <!-- Chad Rules of Discipline (Wide) -->
        <div class="rules-card glass-card">
          <div class="rules-header">
            <div class="rules-title-wrap">
              <span class="rules-icon">🛡️</span>
              <h3 class="rules-title">THE CHADODORO CODE</h3>
            </div>
            <span class="badge-chad">3 IRON PRINCIPLES</span>
          </div>
          <div class="rules-grid">
            <div class="rule-item-card">
              <div class="rule-item-top">
                <span class="rule-num">01</span>
                <strong class="rule-name">Zero Distractions</strong>
              </div>
              <p class="rule-detail">Lock into deep work with unbroken tunnel vision and extreme focus.</p>
            </div>
            <div class="rule-item-card">
              <div class="rule-item-top">
                <span class="rule-num">02</span>
                <strong class="rule-name">Radical Screen Break</strong>
              </div>
              <p class="rule-detail">When time is up, immediately step away from all monitors and recharge.</p>
            </div>
            <div class="rule-item-card">
              <div class="rule-item-top">
                <span class="rule-num">03</span>
                <strong class="rule-name">Touch Physical Grass</strong>
              </div>
              <p class="rule-detail">Reconnect with sunlight, earth, and oxygen to reset your nervous system.</p>
            </div>
          </div>
        </div>

        <!-- Git Voice Vault Info Box -->
        <div class="vault-info-card glass-card">
          <div class="vault-header">
            <div class="vault-title-wrap">
              <span class="vault-icon">🎙️</span>
              <h3 class="vault-title">GIT VOICE VAULT REPOSITORY</h3>
            </div>
            <span class="badge-chad">24 CLIPS COMMITTED</span>
          </div>
          <p class="vault-desc">
            Clips pre-rendered via <code>google/gemma-4-26B-A4B-it</code> and synthesized by <strong>ElevenLabs</strong> across multiple GigaChad voices (Adam, Harry, Brian).
            Served entirely as static assets under <code>public/vault/</code> with 0ms runtime API latency.
          </p>
          <div class="vault-categories-grid">
            <div class="vault-cat-pill">
              <span class="cat-dot dot-focus"></span>
              <span>START_FOCUS (6)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-break"></span>
              <span>SHORT_BREAK (6)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-long"></span>
              <span>LONG_BREAK (6)</span>
            </div>
            <div class="vault-cat-pill">
              <span class="cat-dot dot-motivation"></span>
              <span>CHAD_MOTIVATION (6)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Keyboard Shortcuts Bar -->
    <div class="shortcuts-bar">
      <span class="shortcut-item"><kbd>Space</kbd> Start / Pause</span>
      <span class="shortcut-item"><kbd>R</kbd> Reset</span>
      <span class="shortcut-item"><kbd>S</kbd> Skip Phase</span>
      <span class="shortcut-item"><kbd>M</kbd> Instant Motivation</span>
      <span class="shortcut-item"><kbd>G</kbd> Touch Grass</span>
      <span class="shortcut-item"><kbd>V</kbd> Coach Voice</span>
      <span class="shortcut-item"><kbd>B</kbd> Anthem BGM</span>
      <span class="shortcut-item"><kbd>Esc</kbd> Close Settings</span>
    </div>
  </div>

  <!-- Settings Modal Component -->
  <SettingsModal />
</Layout>

<style>
  .hero-section {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Challenge Strip */
  .challenge-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(18, 24, 36, 0.6);
    border: 1px solid var(--border-subtle);
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .challenge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--emerald-bright);
  }

  .pulse-leaf {
    animation: gentleBounce 2s ease-in-out infinite;
  }

  @keyframes gentleBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .render-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .render-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  /* Main Dashboard Grid */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .dashboard-grid {
      grid-template-columns: 350px 1fr;
    }
  }

  /* Stage Column */
  .col-stage {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Unified Coach Card */
  .coach-unified-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    position: relative;
    overflow: hidden;
  }

  .coach-unified-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--emerald-main) 0%, #38bdf8 50%, var(--gold-main) 100%);
    opacity: 0.85;
  }

  .coach-header {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .coach-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .coach-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .coach-icon {
    font-size: 1.05rem;
    line-height: 1;
  }

  .coach-title {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
    white-space: nowrap;
    margin: 0;
  }

  .coach-header-sub {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .coach-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--emerald-bright);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
  }

  .pulse-emerald {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--emerald-main);
    box-shadow: 0 0 8px var(--emerald-bright);
    animation: pulseDot 2s infinite ease-in-out;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .btn-audio-replay {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--bg-surface);
    color: var(--text-sub);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-audio-replay:hover {
    color: var(--text-main);
    background: var(--bg-card-hover);
    border-color: var(--emerald-main);
  }

  .coach-avatar-area {
    padding: 0.65rem 0 1.25rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Wide Chad Rules of Discipline */
  .rules-card {
    padding: 1.25rem 1.5rem;
  }

  .rules-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rules-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .rules-icon {
    font-size: 1.1rem;
  }

  .rules-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
  }

  .rules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  .rule-item-card {
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.95rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: all 0.2s ease;
  }

  .rule-item-card:hover {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.04);
    transform: translateY(-1px);
  }

  .rule-item-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .rule-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--emerald-bright);
    background: var(--bg-surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .rule-name {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .rule-detail {
    font-size: 0.74rem;
    color: var(--text-sub);
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 768px) {
    .rules-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }

  /* Timer Column */
  .col-timer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timer-card {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Vault Info Card */
  .vault-info-card {
    padding: 1.25rem 1.5rem;
  }

  .vault-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vault-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .vault-icon {
    font-size: 1rem;
  }

  .vault-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-main);
  }

  .vault-desc {
    font-size: 0.8rem;
    color: var(--text-sub);
    line-height: 1.45;
    margin-bottom: 0.85rem;
  }

  .vault-desc code {
    font-family: var(--font-mono);
    background: var(--bg-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--emerald-bright);
    font-size: 0.75rem;
  }

  .vault-categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.5rem;
  }

  .vault-cat-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-sub);
    font-family: var(--font-mono);
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-focus { background: var(--emerald-bright); }
  .dot-break { background: #fde047; }
  .dot-long { background: #38bdf8; }
  .dot-motivation { background: var(--gold-main); }

  /* Shortcuts Bar */
  .shortcuts-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: rgba(18, 24, 36, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .shortcut-item {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  kbd {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  @media (max-width: 680px) {
    .hero-section {
      padding-top: 1rem;
      padding-bottom: 2rem;
      gap: 1.15rem;
    }

    .challenge-strip {
      padding: 0.5rem 0.75rem;
      gap: 0.5rem;
    }

    .challenge-tag {
      font-size: 0.68rem;
    }

    .timer-card {
      padding: 1.5rem 0.85rem;
    }

    .rules-card, .vault-info-card {
      padding: 1.15rem 1rem;
    }

    .shortcuts-bar {
      display: none;
    }
  }
</style>
