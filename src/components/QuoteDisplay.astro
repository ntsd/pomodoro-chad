---
// src/components/QuoteDisplay.astro
---
<div class="quote-speech-bubble" id="quote-display-card">
  <!-- Quote Body -->
  <div class="quote-body">
    <div class="quote-marks">“</div>
    <p class="quote-text" id="quote-text-content">
      Lock in, King. The world belongs to those who conquer distraction.
    </p>
    <div class="quote-marks-close">”</div>
  </div>

  <!-- Card Footer Metadata -->
  <div class="quote-footer">
    <div class="quote-meta-ai">
      <span class="ai-tag" title="Open-Weight Gemma 4 26B on Spark">🧠 gemma-4-26B</span>
      <span class="ai-tag" id="quote-voice-tag" title="Voice generated by ElevenLabs">🎙️ ElevenLabs</span>
      <span class="ai-tag tag-vault">⚡ static vault</span>
    </div>
  </div>
</div>

<style>
  .quote-speech-bubble {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    position: relative;
    width: 100%;
    transition: all 0.25s ease;
  }

  .quote-speech-bubble:hover {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(15, 23, 42, 0.7);
  }

  .quote-body {
    position: relative;
    margin: 0.2rem 0 0.8rem 0;
  }

  .quote-marks {
    font-family: Georgia, serif;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--emerald-main);
    opacity: 0.35;
    position: absolute;
    top: -0.9rem;
    left: -0.3rem;
    pointer-events: none;
  }

  .quote-marks-close {
    font-family: Georgia, serif;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--emerald-main);
    opacity: 0.35;
    display: inline-block;
    vertical-align: sub;
    margin-left: 0.2rem;
    pointer-events: none;
  }

  .quote-text {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.48;
    color: var(--text-main);
    padding-left: 0.9rem;
    letter-spacing: -0.01em;
  }

  .quote-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .quote-meta-ai {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ai-tag {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.18rem 0.42rem;
    border-radius: 4px;
    background: var(--bg-surface);
    color: var(--text-sub);
    border: 1px solid var(--border-subtle);
  }

  .tag-vault {
    color: var(--emerald-bright);
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.25);
  }

  @media (max-width: 600px) {
    .quote-speech-bubble {
      padding: 0.9rem 0.85rem;
    }
    .quote-text {
      font-size: 0.9rem;
      padding-left: 0.7rem;
    }
    .quote-footer {
      justify-content: flex-start;
      gap: 0.4rem;
    }
  }
</style>
