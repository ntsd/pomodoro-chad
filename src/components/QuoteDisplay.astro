---
// src/components/QuoteDisplay.astro
---
<div class="quote-speech-bubble" id="quote-display-card">
  <!-- Quote Body -->
  <div class="quote-body">
    <div class="quote-marks">“</div>
    <p class="quote-text" id="quote-text-content">
      Lock in, King. The world belongs to those who conquer distraction.
    </p>
    <div class="quote-marks-close">”</div>
  </div>

  <!-- Card Footer Metadata -->
  <div class="quote-footer">
    <div class="quote-meta-ai">
      <span class="ai-tag" title="Open-Weight Gemma 4 26B on Spark">🧠 gemma-4-26B</span>
      <span class="ai-tag" id="quote-voice-tag" title="Voice generated by ElevenLabs">🎙️ ElevenLabs</span>
    </div>
  </div>
</div>

<!-- Now Playing Anthem Banner (Below Quote Section) -->
<div class="now-playing-banner" id="now-playing-banner" style="display: none;">
  <div class="now-playing-left">
    <div class="music-wave-bars" id="music-wave-bars">
      <span class="m-bar"></span>
      <span class="m-bar"></span>
      <span class="m-bar"></span>
      <span class="m-bar"></span>
    </div>
    <div class="now-playing-info">
      <span class="now-playing-badge" id="now-playing-badge">PLAYING YOUTUBE SONG</span>
      <div class="now-playing-title-wrap" id="now-playing-title-wrap">
        <span class="now-playing-title" id="now-playing-title">—</span>
      </div>
    </div>
  </div>
  <a href="#" target="_blank" rel="noopener noreferrer" class="now-playing-yt-link" id="now-playing-yt-link" title="Open song on YouTube">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
    <span id="now-playing-link-text">YOUTUBE</span>
    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      <polyline points="15 3 21 3 21 9"></polyline>
      <line x1="10" y1="14" x2="21" y2="3"></line>
    </svg>
  </a>
</div>

<style>
  .quote-speech-bubble {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    position: relative;
    width: 100%;
    transition: all 0.25s ease;
  }

  .quote-speech-bubble:hover {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(15, 23, 42, 0.7);
  }

  .quote-body {
    position: relative;
    margin: 0.2rem 0 0.8rem 0;
  }

  .quote-marks {
    font-family: Georgia, serif;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--emerald-main);
    opacity: 0.35;
    position: absolute;
    top: -0.9rem;
    left: -0.3rem;
    pointer-events: none;
  }

  .quote-marks-close {
    font-family: Georgia, serif;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--emerald-main);
    opacity: 0.35;
    display: inline-block;
    vertical-align: sub;
    margin-left: 0.2rem;
    pointer-events: none;
  }

  .quote-text {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.48;
    color: var(--text-main);
    padding-left: 0.9rem;
    letter-spacing: -0.01em;
  }

  .quote-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .quote-meta-ai {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ai-tag {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.18rem 0.42rem;
    border-radius: 4px;
    background: var(--bg-surface);
    color: var(--text-sub);
    border: 1px solid var(--border-subtle);
  }

  .tag-vault {
    color: var(--emerald-bright);
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.25);
  }

  /* Now Playing Anthem Banner (Below Quote Section) */
  .now-playing-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-top: 0.65rem;
    background: rgba(18, 24, 38, 0.85);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: var(--radius-md);
    padding: 0.55rem 0.75rem;
    gap: 0.55rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .now-playing-banner:hover {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(18, 24, 38, 0.95);
  }

  .now-playing-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    flex: 1 1 0;
    overflow: hidden;
  }

  .music-wave-bars {
    display: flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 14px;
    flex-shrink: 0;
  }

  .m-bar {
    width: 2.5px;
    height: 100%;
    background: #ef4444;
    border-radius: 2px;
    animation: waveBounce 1.2s ease-in-out infinite;
  }

  .m-bar:nth-child(1) { animation-delay: 0s; height: 40%; }
  .m-bar:nth-child(2) { animation-delay: 0.2s; height: 80%; }
  .m-bar:nth-child(3) { animation-delay: 0.4s; height: 100%; }
  .m-bar:nth-child(4) { animation-delay: 0.15s; height: 60%; }

  .music-wave-bars.is-vault .m-bar {
    background: var(--emerald-bright);
  }

  @keyframes waveBounce {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }

  .now-playing-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 0;
    overflow: hidden;
  }

  .now-playing-badge {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #f87171;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .now-playing-badge.is-vault {
    color: var(--emerald-bright);
  }

  .now-playing-title-wrap {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  .now-playing-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    width: 100%;
    max-width: 100%;
    line-height: 1.3;
  }

  /* When title overflows: smooth hardware-accelerated slide */
  .now-playing-title.is-sliding {
    display: inline-block;
    width: max-content;
    max-width: none;
    overflow: visible;
    text-overflow: clip;
    will-change: transform;
    animation: songTitleSlide var(--slide-dur, 8s) cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  .now-playing-title-wrap.is-sliding {
    mask-image: linear-gradient(90deg, #000 0%, #000 calc(100% - 14px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 calc(100% - 14px), transparent 100%);
  }

  .now-playing-title-wrap:hover .now-playing-title.is-sliding {
    animation-play-state: paused;
  }

  @keyframes songTitleSlide {
    0%, 18% {
      transform: translateX(0);
    }
    48%, 68% {
      transform: translateX(calc(-1 * var(--slide-dist, 0px)));
    }
    92%, 100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-playing-title.is-sliding {
      animation: none !important;
      text-overflow: ellipsis;
      overflow: hidden;
      max-width: 100%;
      width: 100%;
      display: block;
    }
    .now-playing-title-wrap.is-sliding {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  .now-playing-yt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .now-playing-yt-link:hover {
    background: rgba(239, 68, 68, 0.28);
    border-color: #ef4444;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .now-playing-yt-link.is-vault {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: var(--emerald-bright);
  }

  .now-playing-yt-link.is-vault:hover {
    background: rgba(16, 185, 129, 0.25);
    border-color: var(--emerald-main);
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .quote-speech-bubble {
      padding: 0.85rem 0.8rem;
    }
    .quote-text {
      font-size: 0.88rem;
      padding-left: 0.7rem;
    }
    .quote-footer {
      justify-content: flex-start;
      gap: 0.4rem;
    }
    .now-playing-banner {
      padding: 0.45rem 0.65rem;
      gap: 0.45rem;
      margin-top: 0.5rem;
    }
    .now-playing-left {
      gap: 0.45rem;
    }
    .now-playing-badge {
      font-size: 0.54rem;
    }
    .now-playing-title {
      font-size: 0.74rem;
    }
    .now-playing-yt-link {
      padding: 0.25rem 0.45rem;
      font-size: 0.62rem;
      gap: 0.25rem;
    }
  }

  @media (max-width: 440px) {
    .now-playing-yt-link span {
      display: none;
    }
    .now-playing-yt-link {
      padding: 0.28rem 0.4rem;
    }
  }

  @media (max-width: 380px) {
    .now-playing-badge {
      font-size: 0.5rem;
    }
    .now-playing-title {
      font-size: 0.7rem;
    }
  }
</style>
