---
// src/components/Timer.astro
---
<div class="timer-component">
  <!-- Mode Selector Tabs -->
  <div class="mode-tabs">
    <button class="mode-tab active" data-mode="focus" id="tab-focus">
      <span class="tab-dot"></span>
      <span>LOCK IN</span>
    </button>
    <button class="mode-tab" data-mode="break" id="tab-break">
      <span class="tab-dot"></span>
      <span>SHORT BREAK</span>
    </button>
    <button class="mode-tab" data-mode="long_break" id="tab-long-break">
      <span class="tab-dot"></span>
      <span>TOUCH GRASS</span>
    </button>
  </div>

  <!-- Circular Countdown Ring -->
  <div class="timer-display-wrap">
    <svg class="progress-ring" viewBox="0 0 280 280">
      <defs>
        <linearGradient id="ringEmeraldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#34d399" />
          <stop offset="100%" stop-color="#10b981" />
        </linearGradient>
        <linearGradient id="ringBreakGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fde047" />
          <stop offset="100%" stop-color="#10b981" />
        </linearGradient>
      </defs>

      <!-- Background track -->
      <circle
        class="progress-ring-bg"
        cx="140"
        cy="140"
        r="120"
      />
      <!-- Animated Progress Circle -->
      <circle
        id="timer-progress-circle"
        class="progress-ring-circle"
        cx="140"
        cy="140"
        r="120"
        stroke="url(#ringEmeraldGradient)"
      />
    </svg>

    <!-- Center Timer Content -->
    <div class="timer-center-content">
      <span class="timer-mode-tag" id="timer-mode-tag">DEEP WORK FOCUS</span>
      <div class="timer-time" id="timer-time-display">25:00</div>
      
      <!-- Cycle dots -->
      <div class="cycle-dots-wrap" title="Pomodoro Cycles">
        <div class="cycle-dot" id="dot-0"></div>
        <div class="cycle-dot" id="dot-1"></div>
        <div class="cycle-dot" id="dot-2"></div>
        <div class="cycle-dot" id="dot-3"></div>
      </div>
      <div class="cycle-text" id="cycle-text-display">ROUND 1 OF 4</div>
    </div>
  </div>

  <!-- Action Controls -->
  <div class="timer-controls">
    <button class="btn-primary timer-btn-main" id="btn-timer-toggle" title="Press Space to toggle">
      <svg class="btn-icon" id="icon-play" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
        <path d="M8 5v14l11-7z" />
      </svg>
      <svg class="btn-icon hidden" id="icon-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
      </svg>
      <span id="btn-toggle-label">LOCK IN NOW</span>
    </button>

    <div class="timer-sub-controls">
      <button class="btn-secondary timer-btn-sub" id="btn-timer-reset" title="Reset current session">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
        </svg>
        <span>RESET</span>
      </button>

      <button class="btn-secondary timer-btn-sub" id="btn-timer-skip" title="Skip to next phase">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 4 15 12 5 20 5 4" fill="currentColor" />
          <line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" />
        </svg>
        <span>SKIP</span>
      </button>
    </div>
  </div>

  <!-- Now Playing Anthem Banner (with YouTube link) -->
  <div class="now-playing-banner" id="now-playing-banner" style="display: none;">
    <div class="now-playing-left">
      <div class="music-wave-bars" id="music-wave-bars">
        <span class="m-bar"></span>
        <span class="m-bar"></span>
        <span class="m-bar"></span>
        <span class="m-bar"></span>
      </div>
      <div class="now-playing-info">
        <span class="now-playing-badge" id="now-playing-badge">PLAYING YOUTUBE SONG</span>
        <span class="now-playing-title" id="now-playing-title">—</span>
      </div>
    </div>
    <a href="#" target="_blank" rel="noopener noreferrer" class="now-playing-yt-link" id="now-playing-yt-link" title="Open song on YouTube">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
      <span id="now-playing-link-text">YOUTUBE</span>
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>

  <!-- Interactive Soundboard & Grass Counter Trigger Section -->
  <div class="chad-interactive-actions">
    <!-- Touch Grass Button -->
    <button class="btn-grass" id="btn-touch-grass" title="Click to log that you touched physical grass!">
      <span class="btn-grass-icon">🌱</span>
      <div class="btn-grass-text">
        <span class="btn-grass-title">I TOUCHED GRASS</span>
        <span class="btn-grass-meta">EARN CHAD REP</span>
      </div>
      <span class="grass-count-badge" id="grass-count-display">0</span>
    </button>

    <!-- Instant Motivation Soundboard -->
    <button class="btn-secondary btn-motivation" id="btn-instant-motivation" title="Instant Stoic Chad Motivation">
      <span class="motivation-icon">⚡</span>
      <div class="motivation-text">
        <span class="motivation-title">INSTANT MOTIVATION</span>
        <span class="motivation-meta">VOICE VAULT CLIP</span>
      </div>
    </button>
  </div>
</div>

<style>
  .timer-component {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    width: 100%;
  }

  /* Mode selector tabs */
  .mode-tabs {
    display: flex;
    background: rgba(18, 24, 36, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.35rem;
    gap: 0.35rem;
    backdrop-filter: blur(10px);
  }

  .mode-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--text-sub);
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .mode-tab .tab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: background-color 0.2s ease;
  }

  .mode-tab:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.04);
  }

  .mode-tab.active {
    background: var(--bg-surface);
    color: var(--text-main);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mode-tab.active .tab-dot {
    background: var(--emerald-bright);
    box-shadow: 0 0 8px var(--emerald-bright);
  }

  /* Timer Display Ring */
  .timer-display-wrap {
    position: relative;
    width: 290px;
    height: 290px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progress-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .progress-ring-bg {
    fill: transparent;
    stroke: var(--bg-card);
    stroke-width: 12;
  }

  .progress-ring-circle {
    fill: transparent;
    stroke-width: 12;
    stroke-linecap: round;
    stroke-dasharray: 753.98; /* 2 * PI * 120 */
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.8s linear, stroke 0.4s ease;
    filter: drop-shadow(0 0 8px var(--emerald-glow-strong));
  }

  .timer-center-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1;
    text-align: center;
  }

  .timer-mode-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--emerald-bright);
    margin-bottom: 0.25rem;
  }

  .timer-time {
    font-family: var(--font-mono);
    font-size: 4.2rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.04em;
    line-height: 1;
    text-shadow: 0 0 30px rgba(16, 185, 129, 0.25);
  }

  .cycle-dots-wrap {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .cycle-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
  }

  .cycle-dot.filled {
    background: var(--emerald-main);
    border-color: var(--emerald-bright);
    box-shadow: 0 0 10px var(--emerald-glow-strong);
  }

  .cycle-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* Timer Controls */
  .timer-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 320px;
  }

  .timer-btn-main {
    width: 100%;
    font-size: 1.05rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
  }

  .btn-icon.hidden {
    display: none;
  }

  .timer-sub-controls {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  .timer-btn-sub {
    flex: 1;
    font-size: 0.82rem;
    padding: 0.65rem 1rem;
    gap: 0.4rem;
  }

  /* Interactive Soundboard & Grass Counter Trigger Section */
  .chad-interactive-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    width: 100%;
    max-width: 520px;
    margin-top: 0.5rem;
  }

  .btn-grass {
    cursor: pointer;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
  }

  .btn-grass-icon {
    font-size: 1.5rem;
  }

  .btn-grass-text, .motivation-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .btn-grass-title, .motivation-title {
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .btn-grass-meta, .motivation-meta {
    font-size: 0.65rem;
    font-weight: 700;
    opacity: 0.8;
    letter-spacing: 0.05em;
  }

  .grass-count-badge {
    background: #032014;
    color: var(--emerald-bright);
    font-size: 0.85rem;
    font-weight: 900;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(52, 211, 153, 0.4);
    box-shadow: inset 0 0 8px rgba(16, 185, 129, 0.4);
  }

  .btn-motivation {
    cursor: pointer;
    justify-content: flex-start;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(245, 158, 11, 0.25);
    background: rgba(24, 34, 54, 0.8);
    gap: 0.75rem;
  }

  .btn-motivation:hover {
    border-color: rgba(245, 158, 11, 0.5);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
  }

  .motivation-icon {
    font-size: 1.4rem;
  }

  .motivation-title {
    color: var(--gold-main);
  }

  /* Now Playing Anthem Banner */
  .now-playing-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: rgba(18, 24, 36, 0.75);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    gap: 0.75rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .now-playing-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .music-wave-bars {
    display: flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 16px;
    flex-shrink: 0;
  }

  .m-bar {
    width: 3px;
    height: 100%;
    background: #ef4444;
    border-radius: 2px;
    animation: waveBounce 1.2s ease-in-out infinite;
  }

  .m-bar:nth-child(1) { animation-delay: 0s; height: 40%; }
  .m-bar:nth-child(2) { animation-delay: 0.2s; height: 80%; }
  .m-bar:nth-child(3) { animation-delay: 0.4s; height: 100%; }
  .m-bar:nth-child(4) { animation-delay: 0.15s; height: 60%; }

  .music-wave-bars.is-vault .m-bar {
    background: var(--emerald-bright);
  }

  @keyframes waveBounce {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }

  .now-playing-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .now-playing-badge {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #f87171;
    text-transform: uppercase;
  }

  .now-playing-badge.is-vault {
    color: var(--emerald-bright);
  }

  .now-playing-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-playing-yt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .now-playing-yt-link:hover {
    background: rgba(239, 68, 68, 0.28);
    border-color: #ef4444;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .now-playing-yt-link.is-vault {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: var(--emerald-bright);
  }

  .now-playing-yt-link.is-vault:hover {
    background: rgba(16, 185, 129, 0.25);
    border-color: var(--emerald-main);
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .mode-tabs {
      width: 100%;
      max-width: 360px;
      justify-content: center;
      gap: 0.25rem;
      padding: 0.25rem;
    }

    .mode-tab {
      padding: 0.45rem 0.65rem;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      gap: 0.35rem;
    }

    .chad-interactive-actions {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .btn-grass, .btn-motivation {
      padding: 0.75rem 0.85rem;
    }

    .timer-display-wrap {
      width: 250px;
      height: 250px;
    }

    .timer-time {
      font-size: 3.5rem;
    }

    .timer-btn-main {
      padding: 0.85rem 1.25rem;
      font-size: 0.95rem;
    }

    .timer-sub-controls {
      gap: 0.5rem;
    }

    .timer-btn-sub {
      padding: 0.55rem 0.75rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 400px) {
    .mode-tab .tab-dot {
      display: none;
    }

    .mode-tab {
      padding: 0.4rem 0.5rem;
      font-size: 0.66rem;
    }

    .timer-display-wrap {
      width: 230px;
      height: 230px;
    }

    .timer-time {
      font-size: 3.1rem;
    }
  }
</style>
