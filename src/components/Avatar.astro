        <path d="M 180 90 C 180 82, 195 76, 205 80 C 215 72, 235 74, 240 84 C 250 82, 260 90, 255 96 Z" fill="#ffffff" opacity="0.75" />

        <!-- Lush Green Meadow Hills -->
        <path d="M 0 200 Q 120 170 320 210 L 320 320 L 0 320 Z" fill="#34d399" opacity="0.6" />
        <path d="M 0 225 Q 160 195 320 235 L 320 320 L 0 320 Z" fill="url(#grassHills)" />

        <!-- Chad Torso in Outdoor Shirtless / Athletic Tank -->
        <path d="M 60 320 C 65 260, 95 235, 125 225 C 145 220, 175 220, 195 225 C 225 235, 255 260, 260 320 Z" fill="#d97706" opacity="0.2" />
        <path d="M 75 320 C 80 270, 105 245, 130 235 L 190 235 C 215 245, 240 270, 245 320 Z" fill="#0f172a" />

        <!-- Massive Neck in Sunlight -->
        <path d="M 125 235 L 132 175 L 188 175 L 195 235 Z" fill="#fcd34d" />

        <!-- Chad Head with Healthy Sun Kissed Tone -->
        <path d="M 110 130 C 110 85, 130 65, 160 65 C 190 65, 210 85, 210 130 C 210 160, 198 180, 185 198 L 160 208 L 135 198 C 122 180, 110 160, 110 130 Z" fill="#fde68a" stroke="#d97706" stroke-width="1.5" />

        <!-- Legendary Chad Jawline & Confident Smirk -->
        <path d="M 116 142 L 136 195 L 160 205 L 184 195 L 204 142" fill="none" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" />
        <line x1="160" y1="198" x2="160" y2="204" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" />
        <!-- Smirk -->
        <path d="M 148 174 Q 160 178 174 170" fill="none" stroke="#92400e" stroke-width="3" stroke-linecap="round" />

        <!-- Chad Hair with Sun Highlights -->
        <path d="M 105 110 C 100 70, 130 40, 160 40 C 190 40, 220 70, 215 110 C 205 85, 185 75, 160 75 C 135 75, 115 85, 105 110 Z" fill="#1e293b" />

        <!-- Cool Chad Aviator Sunglasses Outdoors -->
        <path d="M 122 120 C 122 110, 150 110, 152 124 C 153 134, 126 138, 122 120 Z" fill="#090d16" stroke="#fbbf24" stroke-width="2" />
        <path d="M 168 124 C 170 110, 198 110, 198 120 C 194 138, 167 134, 168 124 Z" fill="#090d16" stroke="#fbbf24" stroke-width="2" />
        <line x1="152" y1="120" x2="168" y2="120" stroke="#fbbf24" stroke-width="2.5" />
        <!-- Sunbeam reflection in glasses -->
