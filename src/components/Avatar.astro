        <line x1="60" y1="20" x2="60" y2="240" stroke="#2a1d0d" stroke-width="2" opacity="0.6" />
        <line x1="90" y1="20" x2="90" y2="240" stroke="#2a1d0d" stroke-width="2" opacity="0.6" />
        <line x1="230" y1="20" x2="230" y2="240" stroke="#2a1d0d" stroke-width="2" opacity="0.6" />
        <line x1="260" y1="20" x2="260" y2="240" stroke="#2a1d0d" stroke-width="2" opacity="0.6" />
        <line x1="290" y1="20" x2="290" y2="240" stroke="#2a1d0d" stroke-width="2" opacity="0.6" />

        <!-- Warm recovery aura -->
        <circle cx="160" cy="150" r="90" fill="#f59e0b" opacity="0.1" filter="blur(20px)" />

        <!-- Relaxed GigaChad Torso in Charcoal & Gold Loungewear -->
        <path d="M 45 320 C 50 265, 80 238, 115 228 C 135 224, 185 224, 205 228 C 240 238, 270 265, 275 320 Z" fill="#1e293b" stroke="#334155" stroke-width="1.5" />
        <path d="M 125 230 L 160 268 L 195 230" stroke="#f59e0b" stroke-width="2" fill="none" opacity="0.75" />

        <!-- Massive Neck in Warm Ambient Light -->
        <path d="M 122 230 L 130 172 L 190 172 L 198 230 Z" fill="#fcd34d" />
        <path d="M 136 178 L 142 225 M 184 178 L 178 225" stroke="#d97706" stroke-width="1.8" stroke-linecap="round" />

        <!-- Iconic Chad Head & Jaw in Warm Light -->
