        </defs>

        <!-- Background Warm Lounge -->
        <rect width="320" height="320" rx="24" fill="url(#shortBreakBg)" />

        <!-- Ambient Warm Light Dome from top-right -->
        <circle cx="260" cy="50" r="110" fill="url(#warmAmberGlow)" />
