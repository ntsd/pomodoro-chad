---
// src/components/Avatar.astro
---
<div class="avatar-container" id="chad-avatar-wrapper">
  <!-- Glowing border ring -->
  <div class="avatar-ring-glow" id="avatar-ring-glow"></div>
  
  <div class="avatar-card" id="avatar-card">
    <!-- State 1: Focus Mode (GigaChad Deep Work Silhouette) -->
    <div class="avatar-state state-focus active" id="avatar-focus">
      <svg class="avatar-svg" viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="focusBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#070a0f" />
            <stop offset="50%" stop-color="#0f172a" />
            <stop offset="100%" stop-color="#051f15" />
          </linearGradient>
          <linearGradient id="chadFocusSkin" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#334155" />
            <stop offset="50%" stop-color="#1e293b" />
            <stop offset="100%" stop-color="#0f172a" />
          </linearGradient>
          <linearGradient id="laserGlow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#34d399" />
            <stop offset="100%" stop-color="#10b981" />
          </linearGradient>
          <filter id="emeraldLaserBlur" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Background gym/deep work grid -->
        <rect width="320" height="320" rx="24" fill="url(#focusBg)" />
        <line x1="0" y1="80" x2="320" y2="80" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <line x1="0" y1="160" x2="320" y2="160" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <line x1="0" y1="240" x2="320" y2="240" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <line x1="80" y1="0" x2="80" y2="320" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <line x1="160" y1="0" x2="160" y2="320" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
        <line x1="240" y1="0" x2="240" y2="320" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />

        <!-- Atmospheric focus aura -->
        <circle cx="160" cy="150" r="110" fill="#10b981" opacity="0.12" filter="blur(30px)" />

        <!-- GigaChad Torso & Shoulders -->
        <path d="M 40 320 C 45 270, 75 240, 110 230 C 130 225, 145 228, 160 230 C 175 228, 190 225, 210 230 C 245 240, 275 270, 280 320 Z" fill="#0f172a" stroke="#1e293b" stroke-width="2" />
        <path d="M 120 235 C 135 245, 145 255, 160 255 C 175 255, 185 245, 200 235" fill="none" stroke="#10b981" stroke-width="2.5" opacity="0.6" />

        <!-- Massive Neck & Traps -->
        <path d="M 115 230 L 125 170 L 195 170 L 205 230 Z" fill="#1e293b" />
        <path d="M 135 180 L 142 225 M 185 180 L 178 225" stroke="#334155" stroke-width="2" stroke-linecap="round" />

        <!-- Iconic Sculpted GigaChad Jaw & Head -->
        <path d="M 100 130 C 100 85, 120 60, 160 60 C 200 60, 220 85, 220 130 C 220 160, 205 180, 190 198 L 160 208 L 130 198 C 115 180, 100 160, 100 130 Z" fill="url(#chadFocusSkin)" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.3" />

        <!-- Razor-sharp Jawline Contour -->
        <path d="M 106 142 L 132 195 L 160 205 L 188 195 L 214 142" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <!-- Chin Cleft -->
        <line x1="160" y1="198" x2="160" y2="204" stroke="#0a0d12" stroke-width="3" stroke-linecap="round" />

        <!-- Chad Pompadour / Coiffed Hair -->
        <path d="M 95 110 C 90 70, 125 35, 160 35 C 195 35, 230 70, 225 110 C 215 80, 190 70, 160 70 C 130 70, 105 80, 95 110 Z" fill="#090d16" stroke="#10b981" stroke-width="1" />

        <!-- Cheekbones -->
        <path d="M 115 138 C 130 145, 140 148, 150 148" stroke="#475569" stroke-width="2" stroke-linecap="round" />
        <path d="M 205 138 C 190 145, 180 148, 170 148" stroke="#475569" stroke-width="2" stroke-linecap="round" />

        <!-- Stoic Nose & Lips -->
        <path d="M 160 120 L 157 155 L 165 156" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 148 174 C 155 171, 165 171, 172 174" stroke="#64748b" stroke-width="3" stroke-linecap="round" />

        <!-- Laser Focused Emerald Chad Eyes -->
        <g filter="url(#emeraldLaserBlur)">
          <ellipse cx="138" cy="122" rx="10" ry="3.5" fill="#10b981" />
          <ellipse cx="182" cy="122" rx="10" ry="3.5" fill="#10b981" />
          <line x1="120" y1="122" x2="148" y2="122" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" />
          <line x1="172" y1="122" x2="200" y2="122" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" />
        </g>
        <circle cx="138" cy="122" r="2" fill="#ffffff" />
        <circle cx="182" cy="122" r="2" fill="#ffffff" />

        <!-- Laser Vision Ray Glint -->
        <line x1="138" y1="122" x2="40" y2="110" stroke="#10b981" stroke-width="1.5" stroke-opacity="0.7" stroke-dasharray="10 5" />
        <line x1="182" y1="122" x2="280" y2="110" stroke="#10b981" stroke-width="1.5" stroke-opacity="0.7" stroke-dasharray="10 5" />

        <!-- Status watermark -->
        <rect x="75" y="275" width="170" height="28" rx="14" fill="#070a0f" stroke="#10b981" stroke-width="1" />
        <text x="160" y="293" fill="#10b981" font-size="11" font-weight="900" font-family="'Plus Jakarta Sans', sans-serif" text-anchor="middle" letter-spacing="2">LOCKED IN // FOCUS</text>
