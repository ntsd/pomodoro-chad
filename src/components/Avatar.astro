        <line x1="173" y1="116" x2="188" y2="130" stroke="#fef08a" stroke-width="2" opacity="0.8" />

        <!-- Chad's Hand Touching Real Physical Grass In Foreground -->
        <!-- Blades of Grass -->
        <g stroke="#059669" stroke-width="3" stroke-linecap="round">
          <path d="M 30 320 Q 40 260 25 230" />
          <path d="M 45 320 Q 60 250 80 220" stroke="#10b981" stroke-width="4" />
          <path d="M 65 320 Q 85 270 70 235" />
          <path d="M 90 320 Q 110 260 135 240" stroke="#34d399" stroke-width="3" />
          <path d="M 180 320 Q 200 270 230 245" stroke="#10b981" stroke-width="4" />
          <path d="M 210 320 Q 230 255 260 225" stroke="#34d399" stroke-width="3" />
          <path d="M 245 320 Q 270 265 295 235" />
          <path d="M 275 320 Q 295 260 305 240" stroke="#059669" stroke-width="4" />
        </g>
        
        <!-- Chad Hand gently caressing physical grass -->
        <path d="M 120 320 C 120 280, 140 260, 165 265 C 175 270, 180 285, 175 320 Z" fill="#fcd34d" stroke="#b45309" stroke-width="2" />
        <!-- Fingers caressing grass blade -->
        <path d="M 150 265 Q 165 245 170 255" fill="none" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 158 268 Q 175 250 178 260" fill="none" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" />

        <!-- Floating 4-Leaf Clover / Grass Seeds -->
        <circle cx="85" cy="205" r="4" fill="#10b981" />
        <circle cx="92" cy="202" r="4" fill="#34d399" />
        <circle cx="88" cy="198" r="4" fill="#10b981" />
        <circle cx="235" cy="210" r="3" fill="#fef08a" />
        <circle cx="250" cy="195" r="2.5" fill="#fef08a" />

        <!-- Status watermark -->
        <rect x="65" y="275" width="190" height="28" rx="14" fill="#047857" stroke="#34d399" stroke-width="1.5" />
        <text x="160" y="293" fill="#ffffff" font-size="11" font-weight="900" font-family="'Plus Jakarta Sans', sans-serif" text-anchor="middle" letter-spacing="2">TOUCHING GRASS 🌿</text>
      </svg>
    </div>
  </div>

  <!-- Audio speech visualizer pill -->
  <div class="avatar-speech-status" id="avatar-speech-status">
    <div class="audio-wave">
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
    </div>
    <span class="speech-label" id="speech-label">CHAD COACHING ACTIVE</span>
  </div>
</div>

<style>
  .avatar-container {
    position: relative;
    width: 260px;
    height: 260px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .avatar-ring-glow {
    position: absolute;
    inset: -6px;
    border-radius: 32px;
    background: radial-gradient(circle, var(--emerald-glow-strong) 0%, rgba(16, 185, 129, 0) 70%);
    opacity: 0.6;
    animation: pulseAura 3s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes pulseAura {
    0%, 100% { opacity: 0.4; transform: scale(0.98); }
    50% { opacity: 0.8; transform: scale(1.02); }
  }

  .avatar-card {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--border-subtle);
    z-index: 1;
    background: var(--bg-card);
  }

  .avatar-state {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.95);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .avatar-state.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .avatar-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .avatar-speech-status {
    position: absolute;
    bottom: -16px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-highlight);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6), 0 0 15px var(--emerald-glow);
    z-index: 2;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.25s ease;
  }

  .avatar-speech-status.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .speech-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--emerald-bright);
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .avatar-container {
      width: 290px;
      height: 290px;
    }
  }
</style>
